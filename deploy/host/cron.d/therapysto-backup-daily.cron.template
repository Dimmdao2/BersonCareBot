# Запускается напрямую /opt/backups/scripts/postgres-backup.sh — это не HTTP-тик вебаппа, общий transport
# run-internal-job.sh его не будит. Скрипт кладёт на хост тот же деплой, что и эту строку.
BERSONCAREBOT_BACKUP_EXPECT_HOSTNAME=therapysto-prod
BERSONCAREBOT_BACKUP_EXPECT_IPV4=135.106.187.95
BERSONCAREBOT_API_ENV_FILE=/etc/therapysto/env/api.prod
BERSONCAREBOT_WEBAPP_ENV_FILE=/etc/therapysto/env/webapp.prod
40 3 * * * root /opt/backups/scripts/postgres-backup.sh daily
