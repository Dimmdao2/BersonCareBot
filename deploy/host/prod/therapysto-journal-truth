#!/usr/bin/env bash
# Спрашивает у боевой базы, сбылось ли то, что обещала каждая миграция, помеченная применённой.
#
# Живёт отдельным root-owned файлом конвейера по той же причине, что и остальные его команды: в
# sudoers можно разрешить КОМАНДУ, но нельзя разрешить строку. Поэтому скрипт не принимает SQL со
# стороны — он собирает его сам из ВЫЛОЖЕННОГО дерева исходников. У учётки deploy нет способа
# подсунуть сюда произвольный запрос к базе.
#
# Печатает строки `RESULT<TAB>тег<TAB>номер<TAB>вердикт<TAB>подробность`. Сравнение с эталоном —
# не здесь: его делает вызывающая сторона (`deploy/host/check-migration-journal-truth.sh`).
set -Eeuo pipefail

SRC=${THERAPYSTO_SRC:-/opt/therapysto/src}
DB=${THERAPYSTO_PROD_DB:-therapysto_prod}
GENERATOR="$SRC/deploy/postgres/migration-journal-truth.mjs"
MIGRATIONS="$SRC/apps/webapp/db/drizzle-migrations"

[ -f "$GENERATOR" ] || { echo "FATAL: нет генератора $GENERATOR" >&2; exit 1; }
[ -d "$MIGRATIONS" ] || { echo "FATAL: нет миграций $MIGRATIONS" >&2; exit 1; }

WORK=$(mktemp -d)
chmod 0755 "$WORK"
trap 'rm -rf "$WORK"' EXIT

node "$GENERATOR" "$MIGRATIONS" > "$WORK/journal-truth.sql"
chmod 0644 "$WORK/journal-truth.sql"

su -s /bin/sh postgres -c \
  "psql -d '$DB' -X -A -t -F '	' -v ON_ERROR_STOP=1 -f '$WORK/journal-truth.sql'" > "$WORK/out.tsv"

grep '^RESULT' "$WORK/out.tsv" || {
  echo "FATAL: база $DB не вернула ни одной строки вердикта" >&2
  exit 1
}
