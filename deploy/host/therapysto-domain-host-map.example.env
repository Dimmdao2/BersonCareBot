# Fill only after the owner approves exact TEST names. Do not commit actual TEST values.
STAFF_HOST=
PLATFORM_ADMIN_HOST=
PATIENT_DEFAULT_HOST=
PATIENT_BRANDED_HOST=
CLINIC_CUSTOM_HOST=
# Approved TEST DNS destination. Every DNS answer must equal this target.
EXPECTED_DNS_TARGET=
# Platform certificate: apex PATIENT_DEFAULT_HOST and wildcard for its subdomains are separate checks.
PLATFORM_TLS_CERTIFICATE_PATH=
PLATFORM_TLS_CERTIFICATE_KEY_PATH=
# Clinic certificate: a separately-issued exact-host pair, never silently shared with platform TLS.
CLINIC_TLS_CERTIFICATE_PATH=
CLINIC_TLS_CERTIFICATE_KEY_PATH=
# Process origins consumed by productSurfaces/requestSurface.
APP_BASE_URL=
PATIENT_APP_ORIGIN=
# Exact callback allowlist approved for the DB-backed yandex_oauth_redirect_uri setting.
YANDEX_OAUTH_REDIRECT_URIS=
# Monitoring exits non-zero at this many days before expiry.
CERT_EXPIRY_WARN_DAYS=30
