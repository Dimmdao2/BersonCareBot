# Root-owned runtime config for the on-demand TLS edge (Caddy) on the new prod host
# 135.106.187.95. See docs/_TODO/CUSTOM_DOMAIN_TLS_EDGE_RUNBOOK_2026-09-07.md for the full design,
# the cutover sequence and named blockers. Nothing here is a product/tenant setting — those stay in
# public.system_settings (AGENTS.md §2/§3); this file only carries edge process values that the
# Caddyfile reads via `{$VAR}` at start. It holds no registrar credentials any more (owner decision
# 12.09.2026: the wildcard certificate and the REG.RU API with it are gone), but it stays root-owned
# (`root:caddy`, mode 0640) because it configures the public TLS edge.
#
# Path on host (mirrors the existing $BCB_ROOT/env layout used by api.prod/webapp.prod/media-worker.prod):
#   /opt/bersoncarebot/env/caddy.prod

# ---------------------------------------------------------------------------------------------
# ACME account / storage
# ---------------------------------------------------------------------------------------------

# Contact address Let's Encrypt uses for expiry/problem notices. Not a per-tenant value.
CADDY_ACME_EMAIL=ops@bersoncare.ru

# Override only for a dry run against Let's Encrypt's staging CA (untrusted cert, no rate-limit
# risk). Leave unset in a real cutover — production issuance must use the default production CA.
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Where Caddy persists its certificate/key store and ACME account state. Must survive restarts and
# `deploy-prod`/`rollback-prod` cycles (those never touch this path); placed next to the existing
# $BCB_ROOT/state directory the blue-green pipeline already owns, not inside a docker volume.
CADDY_DATA_DIR=/opt/bersoncarebot/state/caddy

# ---------------------------------------------------------------------------------------------
# Known fixed platform hostnames (classic HTTP-01/TLS-ALPN — not on-demand)
# ---------------------------------------------------------------------------------------------

# Space-separated Caddyfile address list. These are the hostnames the platform itself owns and
# ships DNS for; Caddy requests/renews a normal managed certificate for each via HTTP-01 the first
# time it starts, no `ask` round-trip involved. `therapygo.ru` has its own block in the Caddyfile
# (the ask endpoint lives on it, so it must not depend on an approval call). Clinic names are NOT
# listed here — neither app.bersoncare.ru nor any `<slug>.therapygo.ru`: they are issued on demand
# through the permission path below, so a new clinic needs no edge edit and no restart.
CADDY_PLATFORM_DOMAINS="therapysto.ru www.therapysto.ru admin.therapysto.ru www.therapygo.ru"

# ---------------------------------------------------------------------------------------------
# On-demand TLS authorization (fail-closed "ask" gate) — B8/C5a
# ---------------------------------------------------------------------------------------------

# Application-owned eligibility endpoint. Caddy issues a GET with only `?domain=<host>` (no other
# query params, no custom headers, 10s timeout, redirects rejected) before ANY on-demand issuance
# and treats anything other than a 2xx response — including connection failure or timeout — as
# deny. This stable platform URL is outside the arbitrary on-demand host being authorized, so the
# permission request cannot depend on that host's certificate or routing readiness.
CADDY_ASK_URL=https://therapygo.ru/api/public/domains/ask

# Where every request that passed a Host match (platform domain, on-demand-approved custom domain,
# or a branded `<slug>.therapygo.ru` subdomain) is reverse-proxied to. This is the existing nginx
# blue-green frontend, moved to a loopback-only port by the cutover script below — never the app
# containers directly, so `deploy-prod`/`rollback-prod` colour switching keeps working unmodified.
CADDY_UPSTREAM=127.0.0.1:8080
