NODE_ENV=production
HOST=127.0.0.1
PORT=6200
APP_BASE_URL=https://therapysto.ru
# New trial PROD is deliberately split: staff/admin uses Therapysto and patients use Therapygo.
PATIENT_APP_ORIGIN=https://therapygo.ru
# DNS targets shown by the clinic-domain binding UI. These app-facing values have one source
# in webapp.prod; the Caddy edge does not read or duplicate them.
CUSTOM_DOMAIN_EDGE_IP=135.106.187.95
CUSTOM_DOMAIN_CNAME_TARGET=edge.therapygo.ru
# Совпадает с DATABASE_URL в api.prod: одна база, одна роль PostgreSQL (схемы public + integrator).
DATABASE_URL=postgres://bcb_webapp_user:password@127.0.0.1:5432/bcb_webapp_prod
# Separate infrastructure login provisioned for E1 operator diagnostics (never reuse app_staff/bootstrap URLs).
SAAS_ISOLATION_OPERATOR_DATABASE_URL=postgres://bcb_saas_operator:password@127.0.0.1:5432/bcb_webapp_prod
# Runtime env webapp. Cutover/backfill/reconcile DB URLs should live in a separate ops-only file,
# e.g. /opt/env/bersoncarebot/cutover.prod (see deploy/env/.env.cutover.prod.example).
SESSION_COOKIE_SECRET=replace-with-long-random-secret-min-32-chars
INTEGRATOR_SHARED_SECRET=replace-with-shared-secret-with-tgcarebot
# URL интегратора для отправки SMS с кодом (POST /api/bersoncare/send-sms). Если не задан — используется заглушка (SMS не уходит).
# INTEGRATOR_API_URL=https://tgcarebot.bersonservices.ru
ALLOW_DEV_AUTH_BYPASS=false
# Числовые Telegram user id (люди), через запятую — whitelist входа. Не путать с username бота (см. TELEGRAM_BOT_USERNAME в apps/webapp/.env.example и telegram_login_bot_username в админке).
ALLOWED_TELEGRAM_IDS=7924656602
# Числовой user id админа в Telegram (человек), не id/username бота
ADMIN_TELEGRAM_ID=364943522
# Опционально: публичный username бота без @ для fallback deep link (если не задан в system_settings). Не числовой id бота.
# TELEGRAM_BOT_USERNAME=your_bot_username
ADMIN_MAX_IDS=
DOCTOR_MAX_IDS=
ADMIN_PHONES=+79643805480
DOCTOR_PHONES=
ALLOWED_PHONES=
# Для входа по Telegram Web App initData (когда открывают из меню без ?t=): тот же токен, что в api.prod
# TELEGRAM_BOT_TOKEN=...
