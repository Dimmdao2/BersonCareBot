# Internal-only nginx frontend for the blue-green pipeline, installed by
# deploy/host/prod/cutover-edge-to-caddy.sh in place of the public-facing
# /etc/nginx/sites-available/therapysto once Caddy has taken over 80/443.
#
# This is the SAME location/proxy_pass contract setup-docker-bluegreen.sh writes into the public
# site today (proxy_set_header Host $host; upgrade support; the same proxy_next_upstream/timeout
# choices) against the SAME `therapysto_webapp` upstream name written by
# /etc/nginx/conf.d/20-therapysto-upstream.conf. therapysto-bluegreen-lib.sh's switch_nginx_to() only ever
# rewrites that upstream file, never this one, so `deploy-prod`/`rollback-prod` colour switching
# needs zero changes to keep working after this cutover. `therapysto_api` is defined in the same upstream
# file but, exactly as in the current public site, is not routed by any location block here — this
# change neither adds nor removes API exposure.
#
# What changed from the public version: no TLS, no security headers (Caddy is now the only thing a
# client's browser ever talks to and owns both), and `listen` is loopback-only on the port Caddy's
# CADDY_UPSTREAM env value points at. This loopback-only listener is the trusted-proxy boundary:
# Caddy has already asserted the external Host, HTTPS scheme, direct client address, and forwarding
# chain. Nginx must preserve those headers verbatim and must never replace them with its own
# loopback peer or `http` hop values.
#
# __THERAPYSTO_EDGE_INTERNAL_PORT__ is substituted by the cutover script from CADDY_UPSTREAM's port
# (deploy/env/.env.caddy.prod.example); it is not read from this file at runtime.

server {
    listen 127.0.0.1:__THERAPYSTO_EDGE_INTERNAL_PORT__;
    server_name _;

    client_max_body_size 2048m;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://therapysto_webapp;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $http_x_real_ip;
        proxy_set_header X-Forwarded-For   $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        # A colour that is being switched away from finishes its in-flight requests; a colour that is
        # not up yet should not hang the browser for a minute before saying so.
        proxy_connect_timeout 5s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}
