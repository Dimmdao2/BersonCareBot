# Common Caddy edge for automatic HTTPS on every name we serve (B7/B8/C5a).
#
# NO REGISTRAR API, BY OWNER DECISION 12.09.2026 (дословно: «Зачем тебе рег ру
# апи? Ты охренел? Не будет у тебя их»). A wildcard certificate for
# *.therapygo.ru is the ONLY thing Let's Encrypt gates behind a DNS-01 challenge,
# i.e. behind write access to the zone REG.RU holds — so the wildcard is gone and
# with it the DNS module. Every name is now issued per-name over HTTP-01/TLS-ALPN,
# which needs nothing but port 80 reaching this process.
#
# What this costs, stated plainly: a name we never issued a certificate for — an
# invented `выдуманное.therapygo.ru` — fails the TLS handshake in the browser
# before a single line of our code runs. No configuration can turn that into a
# friendly page; only a wildcard certificate can, and we chose not to have one.
# A REAL clinic subdomain is unaffected: the `ask` endpoint below approves it and
# Caddy issues its certificate at the first request.
#
# The binary is stock Caddy v2.11.2 (deploy/caddy/build-caddy-edge.sh), no plugins.
#
# Caddy is the only public listener on 80/443. Nginx remains a loopback-only,
# trusted downstream for the existing blue/green therapysto_webapp upstream switch.

(edge_common) {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy {$CADDY_UPSTREAM} {
		# The downstream listener accepts only this Caddy process over loopback, so
		# these are trusted edge assertions, not client-controlled proxy headers.
		header_up Host {hostport}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {hostport}
		header_up X-Forwarded-Proto {scheme}
	}
}

{
	email {$CADDY_ACME_EMAIL}
	acme_ca {$CADDY_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	storage file_system {
		root {$CADDY_DATA_DIR:/opt/therapysto/state/caddy}
	}

	# The built-in module syntax takes the endpoint as its sole argument. A
	# connection error, timeout, redirect, or non-2xx response denies issuance. Production uses the
	# stable, non-circular https://therapygo.ru/api/public/domains/ask endpoint.
	on_demand_tls {
		permission http {$CADDY_ASK_URL}
	}

	log default {
		output file {$CADDY_DATA_DIR:/opt/therapysto/state/caddy}/access.log {
			roll_size 100mb
			roll_keep 10
		}
		format json
	}
}

# The platform apex. Ordinary managed HTTP-01 certificate, requested at first
# start. It is listed separately from the on-demand route on purpose: the `ask`
# endpoint lives ON this host, so the apex must never depend on an approval call
# that would have to reach it first.
therapygo.ru {
	import edge_common
}

# Other fixed platform names use the same ordinary HTTP-01/TLS-ALPN path. Do not
# add a clinic hostname here: app.bersoncare.ru, every clinic's own domain AND
# every `<slug>.therapygo.ru` go through the approved on-demand route below.
{$CADDY_PLATFORM_DOMAINS} {
	import edge_common
}

# Clinic names — their own domains and their `<slug>.therapygo.ru` subdomains.
# The headerless public ask endpoint approves only a hostname we actually serve:
# an eligible custom-domain binding, or a subdomain label that resolves to an
# active published organization. Every unavailable/error response denies
# issuance, so an invented label never even starts an ACME order.
:443 {
	tls {
		on_demand
	}
	import edge_common
}

:80 {
	redir https://{host}{uri} permanent
}
