# coturn config for TEST (#1100 stream C). Placeholders (__LIKE_THIS__) are substituted by
# bin/render-secrets.sh from env/coturn-test.env.example + the host TEST secret store; this file as checked
# into git has no real values. Option names/semantics follow coturn's own documented reference
# (turnserver.conf.default in the coturn source tree) and the official Jitsi turn.md guidance on
# shared-secret authentication.

listening-port=__TURN_LISTEN_PORT__
tls-listening-port=__TURN_TLS_LISTEN_PORT__
min-port=__TURN_RELAY_MIN__
max-port=__TURN_RELAY_MAX__

# Time-limited credentials only (XEP-0215/shared-secret mechanism) — never a static long-term user/password.
use-auth-secret
static-auth-secret=__TURN_SHARED_SECRET__
realm=__TURN_REALM__

# Fixed public address; no STUN self-discovery of our own relay (VM-04: no third-party discovery of
# anything in this stack, including coturn's own address).
external-ip=__TURN_EXTERNAL_IP__
listening-ip=0.0.0.0
relay-ip=__TURN_EXTERNAL_IP__

# TLS material for the 5349 listener (turn.test.bersoncare.ru — see NETWORK_POLICY.md DNS prerequisite).
cert=/etc/coturn/tls/fullchain.pem
pkey=/etc/coturn/tls/privkey.pem
cipher-list="HIGH"
no-tlsv1
no-tlsv1_1

# Never relay to loopback/RFC1918/link-local/etc — coturn must only move ICE media between the two jitsi
# participants, never act as a general pivot into the host's own network. TURN_DENY_PEER_RANGES in
# env/coturn-test.env.example is exploded into repeated denied-peer-ip lines here.
__DENIED_PEER_IP_LINES__

# TEST-scale cap: never more than one active 1:1 relayed call plus headroom for the runbook's forced-TURN
# and JVB-fallback scenarios running back to back.
user-quota=8
total-quota=__TURN_MAX_ALLOCATIONS__

# No CLI/telnet admin interface, no built-in web admin — nothing beyond the TURN/STUN protocol surface
# itself is reachable.
no-cli
# Deliberately NOT setting no-tcp-relay: per coturn's own README.turnserver, that flag disallows RFC 6062
# TCP *relay endpoints* (the protocol between coturn and the peer), which is orthogonal to the TLS
# *transport* between client and coturn that tls-listening-port above already provides — a UDP-restricted
# browser reaching this server over TLS on TURN_TLS_LISTEN_PORT and requesting a normal RFC 5766 UDP relay
# is unaffected by this flag either way. It is left enabled here (not the earlier default) so the runbook's
# forced-TURN-over-TLS fallback scenario also has the RFC 6062 TCP-relay path available as a second-line
# fallback for a client that specifically negotiates it, without narrowing anything this package's security
# posture depends on (shared-secret auth, deny-peer ranges and quotas below are unchanged either way).
no-multicast-peers
no-loopback-peers
no-stdout-log
log-file=/var/log/coturn/turnserver.log
simple-log

# fingerprint/mobility are protocol-correctness options recommended by coturn's own docs for browser
# WebRTC clients, not third-party integrations.
fingerprint
stale-nonce=600
