# Non-secret coturn config for TEST (#1100 stream C). See VERSIONS.md for the pinned image tag.
#
# TURN_SHARED_SECRET is a placeholder here — bin/render-secrets.sh generates it (openssl rand) in the host
# secret store and writes the same value to Jitsi's private TURN_CREDENTIALS env value at apply time. Coturn
# and upstream Prosody external_services therefore share the HMAC key used for XEP-0215 TURN REST credentials.
# It is never printed, logged, or committed.
COTURN_IMAGE_TAG=4.17.2-r0-debian

# The TEST deploy account owns every private coturn mount. Keep these aligned with that account; install.sh
# verifies both the caller and the staged TLS copy before any mutation, so coturn never needs root access.
COTURN_CONTAINER_UID=1000
COTURN_CONTAINER_GID=1000

TURN_REALM=turn.test.therapysto.ru
TURN_LISTEN_PORT=3478
TURN_TLS_LISTEN_PORT=5349
TURN_RELAY_MIN=49152
TURN_RELAY_MAX=49252
TURN_EXTERNAL_IP=151.241.228.122
TURN_CERT_DOMAIN=turn.test.therapysto.ru

# Shared secret (coturn --use-auth-secret / static-auth-secret) — the mechanism, not a static browser
# credential. The value itself is generated, never a literal here.
TURN_SHARED_SECRET=__GENERATED_BY_render-secrets.sh__

# coturn is not a general-purpose relay: deny loopback/link-local/RFC1918 relay targets so it cannot be used
# to reach anything else on the host network, and cap total allocations for a TEST box that only ever needs
# one active 1:1 relayed call at a time.
TURN_DENY_PEER_RANGES="0.0.0.0-0.255.255.255,10.0.0.0-10.255.255.255,100.64.0.0-100.127.255.255,127.0.0.0-127.255.255.255,169.254.0.0-169.254.255.255,172.16.0.0-172.31.255.255,192.0.0.0-192.0.0.255,192.0.2.0-192.0.2.255,192.88.99.0-192.88.99.255,192.168.0.0-192.168.255.255,198.18.0.0-198.19.255.255,198.51.100.0-198.51.100.255,203.0.113.0-203.0.113.255,240.0.0.0-255.255.255.255"
TURN_MAX_ALLOCATIONS=8
