# Non-secret Jitsi Meet / Prosody / Jicofo / JVB config for TEST (#1100 stream C).
#
# This file is a TEMPLATE. It carries no real secret values — every credential-shaped variable below is
# either a placeholder resolved by `bin/render-secrets.sh` from the host-side TEST secret store at apply
# time, or (JWT_APP_SECRET) an externally supplied value this package does not generate or store (see
# README.md "Design decisions"). Copy to `/opt/env/bersoncarebot/jitsi.test` on the TEST host and never
# commit the rendered copy. The host copy must be mode 0600: render-secrets.sh stores the generated internal
# XMPP passwords and TURN_CREDENTIALS there without ever relaxing that permission.
#
# Pinned image tag lives in VERSIONS.md; this variable exists so install.sh has one place to read it from.
# The images actually run by digest (see docker-compose.override.test.yml); this tag only selects which
# vendored source archive install.sh downloads and must be bumped together with those digests and
# ARCHIVE_SHA256 below — see VERSIONS.md "Bumping the pin".
JITSI_RELEASE_TAG=stable-11146-2
# SHA-256 of https://github.com/jitsi/docker-jitsi-meet/archive/refs/tags/${JITSI_RELEASE_TAG}.zip, recorded
# at pin time (VERSIONS.md). bin/install.sh verifies the freshly downloaded archive against this value
# before unzipping it and fails closed on a mismatch — this is a tamper/drift check on the archive
# GitHub serves for this tag, independent of the per-image digests below.
ARCHIVE_SHA256=0dc7f144a68a6272d68dd987718d16af62818ca3488e442241348eb7d1eb17a7

# Deterministic absolute CONFIG tree docker-jitsi-meet's own docker-compose.yml resolves every
# `${CONFIG}/...` volume source against (web, prosody, jicofo, jvb each mount a subdirectory of it). Must
# be an absolute path: a relative or missing CONFIG is exactly finding F1 in
# docs/audit/jitsi-coturn-test-package-2026-09-08.md — compose silently resolved those volumes inside the
# vendored release directory instead, where this package's config files do not exist. bin/install.sh
# creates the required subdirectories under this path before every `up`; same host convention as the
# secret store below (/etc/bersoncarebot/<service>/...).
CONFIG=/etc/bersoncarebot/jitsi-test/config

# --- Domains (see NETWORK_POLICY.md for the DNS prerequisite) ---
XMPP_DOMAIN=meet.test.bersoncare.ru
XMPP_AUTH_DOMAIN=auth.meet.test.bersoncare.ru
XMPP_MUC_DOMAIN=muc.meet.test.bersoncare.ru
XMPP_GUEST_DOMAIN=guest.meet.test.bersoncare.ru
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.test.bersoncare.ru
PUBLIC_URL=https://meet.test.bersoncare.ru
# Dedicated compose subnet lets Prosody validate the host-network coturn
# endpoint without public-IP hairpin NAT. Override both together if this CIDR
# overlaps an existing host route or Docker network.
JITSI_DOCKER_SUBNET=172.30.110.0/24
JITSI_DOCKER_GATEWAY=172.30.110.1

# Web container binds loopback only; the existing host nginx is the one public listener on 443 (see
# nginx/meet-test.vhost.template.conf). HTTP_PORT is both the container's internal plain-HTTP bind and the
# host loopback port nginx proxies to (docker-compose.override.test.yml maps 127.0.0.1:${HTTP_PORT}:8000).
# HTTPS_PORT is kept defined only so upstream's own docker-compose.yml variable substitution for its
# (unused-by-us) `${HTTPS_PORT}:8443` mapping does not warn about a missing variable; with DISABLE_HTTPS=1
# the container's nginx never opens an 8443 listener at all (verified against the pinned tag's own
# web/rootfs/defaults/default template), so this override does not publish 8443 and nginx never proxies to
# it — there is no self-signed-certificate path in this package.
HTTP_PORT=8000
HTTPS_PORT=8443
# docker-jitsi-meet's own Let's Encrypt automation is NOT used (ENABLE_LETSENCRYPT=0): TLS for the public
# hostname is terminated by the existing host nginx, matching every other TEST vhost's convention.
ENABLE_LETSENCRYPT=0
DISABLE_HTTPS=1

TZ=Europe/Moscow

# --- JWT room auth (secure-domain/JWT contract, VM-07 provider-neutral) ---
ENABLE_AUTH=1
AUTH_TYPE=jwt
# Externally supplied: must equal the value the app's `system_settings` (restricted/secret_envelope key,
# see docs/_TODO/VIDEO_MEETINGS_JITSI_2026-09.md §3) holds for this TEST org. This package does not read
# system_settings, does not generate this value, and does not store it anywhere else — it is handed to
# render-secrets.sh at apply time by whoever is wiring stream A + stream C together on TEST.
JWT_APP_SECRET=__EXTERNALLY_SUPPLIED_MUST_MATCH_SYSTEM_SETTINGS__
JWT_APP_ID=bcb-video-meetings-test
JWT_ACCEPTED_ISSUERS=bcb-video-meetings-test
JWT_ACCEPTED_AUDIENCES=bcb-video-meetings-test
# 0: an unsigned/anonymous join must never be accepted — every join needs a room/role/subject/exp token.
JWT_ALLOW_EMPTY=0
JWT_ASAP_KEYSERVER=

# --- Occupancy cap (VM-02): docker-jitsi-meet's own MAX_PARTICIPANTS support, enforced server-side by
# Prosody's mod_muc_max_occupants against live occupant count, independent of JWT subject. See README.md for
# why this is the enforcement mechanism instead of a hand-rolled plugin. ---
MAX_PARTICIPANTS=2

# --- P2P first, our coturn only, our JVB as fallback (VM-03/VM-04) ---
ENABLE_P2P=1
# No default Jitsi/Google STUN. Both lists point only at our own coturn, which answers STUN unauthenticated
# on the same port it answers TURN on.
# docker-jitsi-meet adds the `stun:` URI scheme itself for P2P_STUN_SERVERS; both values therefore use
# the upstream-required host:port shape. Supplying a scheme here renders `stun:stun:...` in config.js.
P2P_STUN_SERVERS=turn.test.bersoncare.ru:3478
JVB_STUN_SERVERS=turn.test.bersoncare.ru:3478
# The pinned upstream Prosody template configures `external_services` globally when TURN_HOST or TURNS_HOST is
# set. This serves both direct XEP-0215 extdisco IQ and the room-metadata component's initial ICE metadata;
# putting the module only on the main VirtualHost leaves the latter with an empty service list.
STUN_HOST=turn.test.bersoncare.ru
STUN_PORT=3478
TURN_HOST=turn.test.bersoncare.ru
TURN_PORT=3478
TURN_TRANSPORT=udp
TURNS_HOST=turn.test.bersoncare.ru
TURNS_PORT=5349
TURN_TTL=3600
# render-secrets.sh synchronizes the generated coturn HMAC key here before compose runs. The upstream
# `external_services` module then generates per-session TURN REST credentials; it never exposes this value
# in served config.js. TURN_USERNAME and TURN_PASSWORD are deliberately omitted: either would create static
# credentials instead of the secret-backed ephemeral credentials required by VM-03/VM-04.
TURN_CREDENTIALS=__GENERATED_BY_render-secrets.sh__
# No extra modules on the main VirtualHost: upstream loads external_services globally from the variables above.
XMPP_MODULES=
# No extra MUC-component modules beyond what MAX_PARTICIPANTS already enables.
XMPP_MUC_MODULES=

# --- JVB advertised address (fixed public address, no STUN discovery of our own bridge) ---
DOCKER_HOST_ADDRESS=151.241.228.122
JVB_ADVERTISE_IPS=151.241.228.122
JVB_PORT=10000
JVB_TCP_PORT=4443
JVB_TCP_HARVESTER_DISABLED=false
# JVB never asks a third party who it is.
JVB_ENABLE_APIS=
# Turns on JVB's own Colibri REST API (loopback-only — upstream's base compose already binds
# JVB_COLIBRI_PORT to 127.0.0.1, this only makes it answer). Needed so bin/health-check.sh can prove actual
# JVB health via `GET /about/health` (jitsi/jitsi-videobridge doc/health-checks.md) instead of only
# `docker inspect` container-running state.
COLIBRI_REST_ENABLED=1
JVB_COLIBRI_PORT=8080

# --- Everything third-party/telemetry/branding explicitly off (VM-04/VM-05/VM-06) ---
ENABLE_LOBBY=0
ENABLE_BREAKOUT_ROOMS=0
DISABLE_POLLS=1
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_JAAS_COMPONENTS=0
ENABLE_GUEST_DOMAIN=0
ENABLE_XMPP_WEBSOCKET=1
# Analytics/callstats/third-party: left unset on purpose (unset, not merely empty-string) so
# docker-jitsi-meet's own templates never emit an analytics/callstats block at all.
# ANALYTICS_APP_ID=
# ANALYTICS_WHITELISTED_EVENTS=
# CALLSTATS_ID=
# CALLSTATS_SECRET=
# AMPLITUDE_ID=
# GOOGLE_ANALYTICS_ID=
DISABLE_DEEP_LINKING=1
ENABLE_CALENDAR=0
ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=1
ENABLE_FILE_RECORDING_SERVICE=0
ENABLE_IPV6=0

# --- Internal (non-app) XMPP passwords — always generated by render-secrets.sh, never hand-set here ---
JICOFO_AUTH_PASSWORD=__GENERATED_BY_render-secrets.sh__
JVB_AUTH_PASSWORD=__GENERATED_BY_render-secrets.sh__
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=

# Restart policy for the compose services; systemd unit also has its own Restart=always at the unit level.
RESTART_POLICY=unless-stopped
