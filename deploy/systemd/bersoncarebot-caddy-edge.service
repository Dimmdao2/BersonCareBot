[Unit]
Description=BersonCare Caddy custom-domain TLS edge
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/opt/bersoncarebot/env/caddy.prod
ExecStart=/usr/local/bin/bcb-caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/bcb-caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/opt/bersoncarebot/state/caddy

[Install]
WantedBy=multi-user.target
