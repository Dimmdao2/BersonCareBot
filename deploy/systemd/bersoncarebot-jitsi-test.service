[Unit]
Description=BersonCareBot self-hosted Jitsi/coturn stack (Test, #1100 stream C)
Documentation=file:/opt/projects/bersoncarebot-test/deploy/jitsi/README.md
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=deploy
Group=deploy
WorkingDirectory=/opt/projects/bersoncarebot-test
EnvironmentFile=/opt/env/bersoncarebot/jitsi.test
ExecStart=/usr/bin/bash deploy/jitsi/bin/install.sh --apply
# Uses bin/stop.sh (full compose context: both compose files + env file), not a bare
# `docker compose -p bcb-jitsi-test down` — that has no compose file to resolve the project definition
# from and cannot be relied on to tear the stack down cleanly (see
# docs/audit/jitsi-coturn-test-package-2026-09-08.md finding F4).
ExecStop=/usr/bin/bash deploy/jitsi/bin/stop.sh
ExecReload=/usr/bin/bash deploy/jitsi/bin/restart.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
