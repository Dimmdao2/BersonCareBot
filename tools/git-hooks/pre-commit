#!/usr/bin/env bash
# Второй гейт защищённой ветки: не дать ОБЫЧНОМУ коммиту дозавершить слияние, которое хук
# reference-transaction уже отклонил, — и не оставить после отказа незавершённой работы.
#
# Требование владельца (06.09.2026): «Если после отказа хука остаётся незавершённая работа,
# значит, хук работает неправильно. Он либо должен отбивать твоё действие до того, как ты его
# начал делать, [либо его надо] либо исправить, либо удалить».
#
# Отбить «до начала» нельзя — это свойство git, а не наша недоработка: `git merge` сначала сводит
# деревья и пишет MERGE_HEAD, и только потом двигает ссылку. Проверено на живом репозитории:
# отказ и в reference-transaction, и в pre-merge-commit оставляет ровно одно состояние —
# «слияние в процессе», причём git сам печатает «use 'git commit' to complete the merge».
# Именно так 06.09 отклонённое слияние уехало в feat под сообщением следующего коммита.
#
# Раз момент «до начала» недостижим, отказ обязан УБИРАТЬ ЗА СОБОЙ: хук отменяет незавершённое
# слияние сам, и дерево возвращается ровно в то состояние, в котором было до `git merge`.
# Тогда после отказа нет ни половины работы, ни ловушки для следующего коммита.
set -euo pipefail

PROTECTED=feat/doctor-ui-rebuild

[ "${ORCH_LAND:-}" != 1 ] || exit 0
[ "$(git symbolic-ref --short -q HEAD || true)" = "$PROTECTED" ] || exit 0
[ -e "$(git rev-parse --git-path MERGE_HEAD)" ] || exit 0

if git merge --abort 2>/dev/null; then
  cat >&2 <<MSG
ОТКАЗ: в $PROTECTED было незавершённое слияние — этот коммит дозавершил бы его и приземлил
  ветку мимо порта, под своим сообщением. Ровно так это и случилось 06.09.

  Слияние ОТМЕНЕНО этим хуком: дерево вернулось в состояние до \`git merge\`, доделывать нечего.
  Повтори свой коммит — теперь он пройдёт.

  Приземлить ветку законно: tools/orch-launch.sh land <клон> <ветка>
MSG
else
  cat >&2 <<MSG
ОТКАЗ: в $PROTECTED не завершено слияние — этот коммит дозавершил бы его и приземлил ветку
  мимо порта. Отменить автоматически не вышло (обычно так бывает, когда до слияния в дереве
  уже лежали несохранённые правки, и \`git merge --abort\` не может их сохранить).

  Разберись вручную:  git merge --abort   (или git status — посмотреть, что мешает)
  Приземлить законно: tools/orch-launch.sh land <клон> <ветка>
MSG
fi
exit 1
