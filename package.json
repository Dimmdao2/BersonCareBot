{
  "name": "berson-care-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @bersoncare/integrator --filter @bersoncare/webapp run dev",
    "dev:integrator": "pnpm --dir apps/integrator dev",
    "worker:dev": "pnpm --dir apps/integrator worker:dev",
    "scheduler:dev": "pnpm --dir apps/integrator scheduler:dev",
    "dev:stop": "bash scripts/kill-local-dev-ports.sh",
    "webapp:dev": "bash scripts/kill-local-dev-ports.sh && pnpm --dir apps/webapp dev",
    "dev:turbo": "bash scripts/kill-local-dev-ports.sh && pnpm --dir apps/webapp dev:turbo",
    "build": "pnpm --dir packages/operator-db-schema run build && pnpm --dir packages/db-principal run build && pnpm --dir packages/error-tracking run build && pnpm --dir apps/integrator build",
    "build:webapp": "pnpm --dir packages/error-tracking run build && pnpm --dir apps/webapp build",
    "build:admin": "cd admin && pnpm install && pnpm run build",
    "start": "pnpm --dir apps/integrator start",
    "webapp:start": "pnpm --dir apps/webapp start",
    "webapp:typecheck": "pnpm --dir apps/webapp typecheck",
    "worker:start": "pnpm --dir apps/integrator worker:start",
    "scheduler:start": "pnpm --dir apps/integrator scheduler:start",
    "scheduler:start:host": "pnpm --dir apps/integrator scheduler:start",
    "test": "pnpm --dir apps/integrator test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:webapp": "pnpm --dir apps/webapp test",
    "test:webapp:fast": "pnpm --dir apps/webapp test:fast",
    "test:webapp:unit": "pnpm --dir apps/webapp test:unit",
    "test:webapp:route": "pnpm --dir apps/webapp test:route",
    "test:webapp:ui": "pnpm --dir apps/webapp test:ui",
    "test:webapp:behavior": "pnpm --dir apps/webapp test:behavior",
    "test:media-worker": "pnpm --dir apps/media-worker test",
    "test:db-principal": "pnpm --dir packages/db-principal test",
    "test:db-privileges": "node --test deploy/postgres/privileges/*.test.mjs",
    "test:e2e": "pnpm --dir apps/integrator test:e2e",
    "lint": "eslint . && node scripts/check-db-chokepoint.mjs && node scripts/check-no-new-raw-sql.mjs && node scripts/check-queue-port-boundary.mjs && node scripts/check-test-runner-visibility.mjs && node scripts/check-c4-migration-owned-function-bodies.mjs && pnpm --dir apps/webapp run lint",
    "lint:fix": "eslint . --fix && pnpm --dir apps/webapp run lint --fix",
    "typecheck": "pnpm --dir packages/operator-db-schema run build && pnpm --dir packages/db-principal run build && pnpm --dir packages/platform-merge run build && pnpm --dir packages/error-tracking run build && pnpm -r --parallel run typecheck",
    "prove:error-tracking-load": "pnpm --dir packages/error-tracking run build && pnpm --dir apps/integrator run build && node --expose-gc scripts/prove-error-tracking-load.mjs",
    "prove:error-tracking-load:3": "pnpm --dir packages/error-tracking run build && pnpm --dir apps/integrator run build && for run in 1 2 3; do node --expose-gc scripts/prove-error-tracking-load.mjs; done",
    "check:saas-db-regression": "node scripts/check-saas-db-regression.mjs",
    "refresh:prod-to-target-cutover": "node scripts/refresh-prod-to-target-cutover.mjs --confirm-local-dev-target-refresh",
    "check:prod-to-target-cutover": "node scripts/refresh-prod-to-target-cutover.mjs --check",
    "check:saas-s5-2-settings-security": "node docs/_TODO/SAAS_FOUNDATION/scripts/check-s5-2-settings-security.mjs",
    "check:new-table-rls-coverage": "node docs/_TODO/SAAS_FOUNDATION/scripts/check-new-table-rls-coverage.mjs",
    "check:saas-product-smoke-contract": "node docs/_TODO/SAAS_FOUNDATION/scripts/check-saas-product-smoke-contract.mjs && node docs/_TODO/SAAS_FOUNDATION/scripts/check-saas-product-smoke-contract.mjs --self-test",
    "check:owner-ready-test-integration": "node --check docs/_TODO/SAAS_FOUNDATION/scripts/check-owner-ready-test-integration.mjs && node docs/_TODO/SAAS_FOUNDATION/scripts/check-owner-ready-test-integration.mjs && node docs/_TODO/SAAS_FOUNDATION/scripts/check-owner-ready-test-integration.mjs --self-test",
    "check:test-visual-global-admin-session": "node --check deploy/host/test-visual-global-admin-session.mjs && node --check deploy/host/capture-test-global-admin-system-health.mjs && node deploy/host/test-visual-global-admin-session.mjs --self-test && node deploy/host/capture-test-global-admin-system-health.mjs --self-test",
    "check:saas-b1-doctor-admin-identity": "node --check docs/_TODO/SAAS_FOUNDATION/scripts/check-b1-doctor-admin-identity.mjs && node docs/_TODO/SAAS_FOUNDATION/scripts/check-b1-doctor-admin-identity.mjs --self-test",
    "check:saas-c2-secrets-deployment-plumbing": "node --check deploy/host/saas-c2-secret-preflight.mjs && node deploy/host/saas-c2-secret-preflight.mjs --self-test",
    "check:saas-d1-664-with-check-reverify": "node --check docs/_TODO/SAAS_FOUNDATION/scripts/check-d1-664-with-check-reverify.mjs && node docs/_TODO/SAAS_FOUNDATION/scripts/check-d1-664-with-check-reverify.mjs",
    "rehearse:e1-patient-capabilities": "node docs/_TODO/SAAS_FOUNDATION/scripts/rehearse-e1-patient-runtime-capabilities.mjs",
    "smoke:saas-product": "node docs/_TODO/SAAS_FOUNDATION/scripts/smoke-saas-product.mjs",
    "preci": "node scripts/ci-preflight.mjs",
    "ci": "node scripts/ci-record.mjs",
    "ci:steps": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm test:db-principal && pnpm test:db-privileges && pnpm test:webapp && pnpm test:media-worker && pnpm build && pnpm build:webapp && pnpm run audit",
    "ci:resume:after-lint": "pnpm typecheck && pnpm test && pnpm test:scripts && pnpm test:db-principal && pnpm test:db-privileges && pnpm test:webapp && pnpm test:media-worker && pnpm build && pnpm build:webapp && pnpm run audit",
    "ci:resume:after-typecheck": "pnpm test && pnpm test:scripts && pnpm test:db-principal && pnpm test:db-privileges && pnpm test:webapp && pnpm test:media-worker && pnpm build && pnpm build:webapp && pnpm run audit",
    "ci:resume:after-test": "pnpm test:scripts && pnpm test:db-principal && pnpm test:db-privileges && pnpm test:webapp && pnpm test:media-worker && pnpm build && pnpm build:webapp && pnpm run audit",
    "ci:resume:after-test-db-principal": "pnpm test:db-privileges && pnpm test:webapp && pnpm test:media-worker && pnpm build && pnpm build:webapp && pnpm run audit",
    "ci:resume:after-test-webapp": "pnpm test:media-worker && pnpm build && pnpm build:webapp && pnpm run audit",
    "ci:resume:after-test-media-worker": "pnpm build && pnpm build:webapp && pnpm run audit",
    "ci:resume:after-build": "pnpm build:webapp && pnpm run audit",
    "ci:resume:after-build-webapp": "pnpm run audit",
    "check": "pnpm ci",
    "push:checked": "bash tools/git-push-and-wait.sh",
    "audit": "node scripts/check-saas-db-regression.mjs && pnpm run check:saas-product-smoke-contract && node scripts/registry-prod-audit.mjs",
    "audit:cve": "pnpm audit --audit-level=high",
    "format": "prettier -w .",
    "migrate:dev": "bash deploy/host/migrate-dev.sh --execute",
    "migrate:webapp": "pnpm --dir apps/webapp run migrate",
    "db:migrate": "pnpm --dir apps/integrator run db:migrate",
    "db:migrate:prod": "pnpm --dir apps/integrator run db:migrate:prod",
    "scenarios": "pnpm --dir apps/integrator run scenarios",
    "build:host": "pnpm --dir apps/integrator build",
    "start:host": "pnpm --dir apps/integrator start",
    "worker:start:host": "pnpm --dir apps/integrator worker:start",
    "migrate:host": "pnpm --dir apps/integrator run db:migrate:prod",
    "auto-close-conversations": "pnpm --dir apps/integrator run auto-close-conversations",
    "auto-close-conversations:host": "pnpm --dir apps/integrator run auto-close-conversations:host",
    "smsc:check": "pnpm --dir apps/integrator run smsc:check",
    "s3:check": "pnpm --dir apps/integrator run s3:check",
    "mail:check": "pnpm --dir apps/integrator run mail:check",
    "stage4-gate": "node scripts/stage4-release-gate.mjs",
    "stage6-gate": "node scripts/stage6-release-gate.mjs",
    "stage7-gate": "node scripts/stage7-release-gate.mjs",
    "stage9-gate": "node scripts/stage9-release-gate.mjs",
    "stage11-gate": "node scripts/stage11-release-gate.mjs",
    "stage12-gate": "node scripts/stage12-release-gate.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "sharp",
      "@ffmpeg-installer/ffmpeg",
      "@ffmpeg-installer/linux-x64",
      "@ffmpeg-installer/linux-arm64",
      "@ffmpeg-installer/darwin-x64",
      "@ffmpeg-installer/darwin-arm64"
    ],
    "overrides": {
      "postcss": ">=8.5.26",
      "nanoid": "3.3.18",
      "fast-uri": "3.1.5",
      "fast-xml-builder": ">=1.1.7",
      "fast-xml-parser": ">=5.7.3",
      "fastify": ">=5.11.3",
      "find-my-way": ">=9.7.0",
      "jsdom": "^26.0.0",
      "flatted": ">=3.4.2",
      "dompurify": "3.4.13",
      "esbuild": ">=0.28.1",
      "@esbuild-kit/core-utils>esbuild": ">=0.28.1",
      "micromatch>picomatch": "2.3.2",
      "@dotenvx/dotenvx>picomatch": "4.0.5",
      "fdir>picomatch": "4.0.5",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@10>brace-expansion": "5.0.9",
      "path-to-regexp": ">=8.4.0",
      "hono": "4.12.34",
      "@hono/node-server": "2.0.11",
      "sharp": "0.35.3",
      "ip-address": ">=10.3.1",
      "ws": ">=8.21.0",
      "qs": ">=6.15.2",
      "js-yaml": "4.3.1",
      "body-parser": "2.3.0",
      "form-data": ">=4.0.6",
      "@babel/core": ">=7.29.6",
      "nodemailer": ">=9.0.5",
      "vite": ">=8.2.1",
      "undici": ">=8.9.0",
      "@stryker-mutator/instrumenter>@babel/core": "7.29.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
