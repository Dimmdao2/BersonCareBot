      "method": "GET",
      "path": "/app/doctor/analytics/notifications",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.content.cms",
      "actor": "doctor",
      "category": "content",
      "method": "GET",
      "path": "/app/doctor/content",
      "expectStatus": 200,
