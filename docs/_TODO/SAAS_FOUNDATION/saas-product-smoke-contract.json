{
  "schemaVersion": 1,
  "phase": "A1",
  "description": "Tenant Hard Mode product smoke matrix. Fixture values are supplied outside the repo.",
  "modes": ["dormant", "shadow", "locked"],
  "failureClassifiers": [
    "auth_denied",
    "known_g1_doctor_admin_identity",
    "server_error",
    "next_render_digest",
    "permission_or_rls_error",
    "unexpected_empty_fixture",
    "forbidden_body_text"
  ],
  "requiredFixtureRefs": [
    "doctorClientUserId",
    "patientProgramInstanceId",
    "patientProgramItemId",
    "mediaFileId",
    "publicBookingServiceId"
  ],
  "readOnlyScenarios": [
    {
      "id": "doctor.workspace.home",
      "actor": "doctor",
      "category": "doctor",
      "method": "GET",
      "path": "/app/doctor",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.schedule.calendar",
      "actor": "doctor",
      "category": "schedule",
      "method": "GET",
      "path": "/app/doctor/schedule",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.working-hours.api",
      "actor": "doctor",
      "category": "working_hours",
      "method": "GET",
      "path": "/api/doctor/booking-engine/working-hours",
      "expectStatus": 200,
      "jsonExpectation": "object",
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.appointments.list",
      "actor": "doctor",
      "category": "bookings",
      "method": "GET",
      "path": "/api/doctor/appointments/list",
      "expectStatus": 200,
      "jsonExpectation": "non_empty",
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.clients.list",
      "actor": "doctor",
