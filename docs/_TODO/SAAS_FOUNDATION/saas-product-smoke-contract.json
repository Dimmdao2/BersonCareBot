{
  "schemaVersion": 1,
  "phase": "A1",
  "description": "Tenant Hard Mode product smoke matrix. Fixture values are supplied outside the repo.",
  "modes": ["dormant", "shadow", "locked"],
  "failureClassifiers": [
    "auth_denied",
    "known_g1_doctor_admin_identity",
    "server_error",
    "next_render_digest",
    "permission_or_rls_error",
    "unexpected_empty_fixture",
    "forbidden_body_text"
  ],
  "requiredFixtureRefs": [
    "doctorClientUserId",
    "patientProgramInstanceId",
    "patientProgramItemId",
    "mediaFileId",
    "publicBookingServiceId",
    "clinicAAppointmentId"
  ],
  "readOnlyScenarios": [
    {
      "id": "doctor.workspace.home",
      "actor": "doctor",
      "category": "doctor",
      "method": "GET",
      "path": "/app/doctor",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.schedule.calendar",
      "actor": "doctor",
      "category": "schedule",
      "method": "GET",
      "path": "/app/doctor/schedule",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.working-hours.api",
      "actor": "doctor",
      "category": "working_hours",
      "method": "GET",
      "path": "/api/doctor/booking-engine/working-hours",
      "expectStatus": 200,
      "jsonExpectation": {
        "type": "object",
        "requireSuccess": true,
        "nonEmptyPaths": ["rows"]
      },
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.appointments.list",
      "actor": "doctor",
      "category": "bookings",
      "method": "GET",
      "path": "/api/doctor/appointments/list?view=past&offset=0&limit=1",
      "expectStatus": 200,
      "jsonExpectation": {
        "type": "object",
        "requireSuccess": true,
        "nonEmptyPaths": ["appointments"]
      },
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.patients.list",
      "actor": "doctor",
      "category": "client_card",
      "method": "GET",
      "path": "/app/doctor/patients",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.client.card",
      "actor": "doctor",
      "category": "client_card",
      "method": "GET",
      "path": "/app/doctor/patients/{doctorClientUserId}",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.analytics.notifications",
      "actor": "global_admin",
      "category": "analytics",
      "method": "GET",
      "path": "/app/doctor/analytics?tab=app",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.content.cms",
      "actor": "doctor",
      "category": "content",
      "method": "GET",
      "path": "/app/doctor/content",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.broadcasts.surface",
      "actor": "doctor",
      "category": "broadcasts",
      "method": "GET",
      "path": "/app/doctor/communications?tab=broadcasts",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "admin.settings.surface",
      "actor": "clinic_admin",
      "category": "admin_settings",
      "method": "GET",
      "path": "/app/settings",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "global-admin.system-health.api",
      "actor": "global_admin",
      "category": "system_health",
      "method": "GET",
      "path": "/api/admin/system-health",
      "expectStatus": 200,
      "jsonExpectation": {
        "type": "object",
        "requiredPaths": [
          "webappDb",
          "meta.probes",
          "saasIsolation.schemaVersion",
          "saasIsolation.status",
          "saasIsolation.coverageFresh",
          "saasIsolation.coverageComplete",
          "saasIsolation.trend.current24Hours",
          "saasIsolation.trend.daily7Days"
        ],
        "allowedValues": [
          { "path": "saasIsolation.schemaVersion", "values": [3] },
          { "path": "saasIsolation.status", "values": ["okay", "stale", "incomplete", "critical"] }
        ]
      }
    },
    {
      "id": "doctor.system-health.denied",
      "actor": "doctor",
      "category": "system_health",
      "method": "GET",
      "path": "/api/admin/system-health",
      "expectStatus": 403,
      "expectAuthDenial": true,
      "expectedErrorValues": ["forbidden", "admin_mode_required"]
    },
    {
      "id": "clinic-admin.system-health.denied",
      "actor": "clinic_admin",
      "category": "system_health",
      "method": "GET",
      "path": "/api/admin/system-health",
      "expectStatus": 403,
      "expectAuthDenial": true,
      "expectedErrorValues": ["forbidden", "admin_mode_required"]
    },
    {
      "id": "patient.appointments.surface",
      "actor": "patient",
      "category": "patient_appointments",
      "method": "GET",
      "path": "/app/patient/cabinet",
      "expectStatus": 200,
      "minBodyBytes": 800
    },
    {
      "id": "patient.program.surface",
      "actor": "patient",
      "category": "patient_program",
      "method": "GET",
      "path": "/app/patient/treatment/{patientProgramInstanceId}",
      "expectStatus": 200,
      "minBodyBytes": 800
    },
    {
      "id": "patient.program.item.discussion-summary",
      "actor": "patient",
      "category": "patient_program_media",
      "method": "GET",
      "path": "/api/patient/treatment-program-instances/{patientProgramInstanceId}/discussion/summary?itemIds={patientProgramItemId}",
      "expectStatus": 200,
      "jsonExpectation": {
        "type": "object",
        "requireSuccess": true,
        "fixtureKeys": [{ "path": "summaryByItemId", "ref": "patientProgramItemId" }]
      }
    },
    {
      "id": "patient.media.playback",
      "actor": "patient",
      "category": "patient_media",
      "method": "GET",
      "path": "/api/media/{mediaFileId}/playback",
      "expectStatus": 200,
      "jsonExpectation": {
        "type": "object",
        "requiredPaths": ["delivery", "mp4.url"],
        "fixtureEquals": [{ "path": "mediaId", "ref": "mediaFileId" }],
        "fixtureContains": [{ "path": "mp4.url", "ref": "mediaFileId" }],
        "allowedValues": [{ "path": "delivery", "values": ["hls", "mp4", "file"] }]
      }
    },
    {
      "id": "public.app.entry",
      "actor": "public",
      "category": "public_auth",
      "method": "GET",
      "path": "/app",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "bodyIncludes": ["app-entry-content"]
    },
    {
      "id": "public.login.config",
      "actor": "public",
      "category": "public_auth",
      "method": "GET",
      "path": "/api/auth/login/alternatives-config",
      "expectStatus": 200,
      "jsonExpectation": {
        "type": "object",
        "requiredPaths": ["ok"]
      }
    },
    {
      "id": "public.specialist-clinic-registration.entry",
      "actor": "public",
      "category": "public_auth",
      "method": "GET",
      "path": "/api/auth/login/alternatives-config",
      "expectStatus": 200,
      "jsonExpectation": {
        "type": "object",
        "requireSuccess": true,
        "allowedValues": [
          { "path": "specialistSignupEnabled", "values": [true] }
        ]
      }
    },
    {
      "id": "public.booking.entry",
      "actor": "public",
      "category": "public_booking",
      "method": "GET",
      "path": "/book",
      "expectStatus": 200,
      "minBodyBytes": 800
    },
    {
      "id": "public.booking.slots",
      "actor": "public",
      "category": "public_booking",
      "method": "GET",
      "path": "/api/booking/public/slots?type=in_person&branchServiceId={publicBookingServiceId}",
      "expectStatus": 200,
      "jsonExpectation": {
        "type": "object",
        "requireSuccess": true,
        "nonEmptyPaths": ["slots"]
      }
    }
  ],
  "mutationScenarios": [
    {
      "id": "global-admin.clinical-write.denied",
      "actor": "global_admin",
      "category": "bookings",
      "method": "POST",
      "path": "/api/doctor/booking-engine/appointments/{clinicAAppointmentId}/comments",
      "requestJson": { "body": "owner-ready locked denial probe" },
      "expectStatus": 403,
      "expectAuthDenial": true,
      "expectedErrorValues": ["doctor_workspace_membership_required", "forbidden"],
      "disabledByDefault": true,
      "note": "Global admin has no implicit tenant clinical workspace and must not write tenant records."
    },
    {
      "id": "server-action.forwarded-host.sentinel",
      "actor": "public",
      "category": "server_actions",
      "method": "POST",
      "path": "/api/booking/actions",
      "expectStatus": 400,
      "disabledByDefault": true,
      "note": "A2 wires a controlled Server Action/proxy regression request; A1 records the slot only."
    }
  ]
}
