      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.client.card",
      "actor": "doctor",
      "category": "client_card",
      "method": "GET",
      "path": "/app/doctor/clients/{doctorClientUserId}",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "doctor.analytics.notifications",
      "actor": "doctor",
