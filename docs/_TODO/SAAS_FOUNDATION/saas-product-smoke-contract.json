      "actor": "clinic_admin",
      "category": "admin_settings",
      "method": "GET",
      "path": "/app/settings",
      "expectStatus": 200,
      "minBodyBytes": 800,
      "knownFailureHint": "G1"
    },
    {
      "id": "admin.system-health.api",
      "actor": "clinic_admin",
      "category": "system_health",
      "method": "GET",
      "path": "/api/admin/system-health",
