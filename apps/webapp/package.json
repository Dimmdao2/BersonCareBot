    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/luxon3": "6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "@smastrom/react-rating": "^1.5.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-task-item": "^3.30.0",
    "@tiptap/extension-task-list": "^3.30.0",
    "@tiptap/markdown": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "altcha": "3.2.1",
    "altcha-lib": "2.3.2",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.6.17",
    "isomorphic-dompurify": "^3.13.0",
    "jose": "^5.10.0",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "next": "16.2.11",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.17",
    "react-select": "5.10.2",
    "react-timezone-select": "^3.3.3",
    "recharts": "3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/luxon": "^3.7.4",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
