{
  "name": "@bersoncare/webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:stop": "bash ../../scripts/kill-local-dev-ports.sh",
    "dev": "bash ../../scripts/kill-local-dev-ports.sh && next dev --webpack -H 127.0.0.1 -p 5200",
    "dev:turbo": "bash ../../scripts/kill-local-dev-ports.sh && next dev -H 127.0.0.1 -p 5200",
    "dev:visual": "bash ../../scripts/kill-local-dev-ports.sh && WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true next dev --webpack -H 127.0.0.1 -p 5200",
    "lint": "eslint . && node ../../scripts/check-no-new-raw-sql.mjs && node ../../scripts/check-webapp-infra-import-boundary.mjs && node ../../scripts/check-webapp-infra-import-boundary.mjs --self-test && node ../../scripts/check-media-delivery-chokepoint.mjs && node ../../scripts/check-transaction-quota-port-boundary.mjs && node ../../scripts/check-transaction-quota-port-boundary.mjs --self-test && bash scripts/check-legacy-migrations-frozen.sh && bash scripts/check-drizzle-journal-sync.sh && node scripts/check-media-upload-door.mjs && node scripts/check-media-upload-door.mjs --self-test",
    "check:c4a-843-clinic-invite-concurrency": "node scripts/check-c4a-843-clinic-invite-concurrency.mjs",
    "build": "rm -rf .next/standalone && NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=4096}\" NODE_ENV=production next build && bash ../../deploy/host/sync-webapp-standalone-assets.sh",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start -H 127.0.0.1 -p 6200",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:fast": "vitest --run --project=fast$([ -n \"$VITEST_SHARD\" ] && printf ' --shard=%s' \"$VITEST_SHARD\")",
    "test:unit": "vitest --run --project=unit",
    "test:route": "vitest --run --project=route",
    "test:ui": "vitest --run --project=ui",
    "test:behavior": "pnpm run test:unit && pnpm run test:route && pnpm run test:ui",
    "test:e2e": "vitest --run e2e/",
    "test:e2e:live": "E2E_LIVE_DEV=1 vitest --run e2e/live-dev.test.ts",
    "test:db-behavior:patient-reminder-materialization:named-dev": "tsx scripts/patient-reminder-materialization-named-dev-step.ts --run",
    "test:db-behavior:patient-reminder-materialization:named-dev:self-test": "tsx --test scripts/patient-reminder-materialization-named-dev-step.test.ts",
    "migrate": "node scripts/run-webapp-drizzle-migrate.mjs",
    "backfill-person-domain": "node scripts/backfill-person-domain.mjs",
    "backfill-communication-history": "node scripts/backfill-communication-history.mjs",
    "reconcile-person-domain": "node scripts/reconcile-person-domain.mjs",
    "reconcile-communication-domain": "node scripts/reconcile-communication-domain.mjs",
    "backfill-reminders-domain": "node scripts/backfill-reminders-domain.mjs",
    "reconcile-reminders-domain": "node scripts/reconcile-reminders-domain.mjs",
    "seed-content": "node scripts/seed-content-pages.mjs",
    "cutover:legacy-appointments": "tsx scripts/cutover-legacy-appointments.ts",
    "cutover:legacy-appointments:test": "vitest run --config scripts/cutover-legacy-appointments.vitest.config.ts",
    "seed:saas-test-walkthrough": "tsx scripts/seed-saas-test-walkthrough-fixtures.ts",
    "test-fixture:patient-organization-lifecycle": "tsx scripts/patient-organization-test-lifecycle.ts",
    "update:saas-product-smoke-fixture-canonical-slots": "tsx scripts/update-saas-product-smoke-fixture-canonical-slots.ts",
    "test:saas-product-smoke-fixture-canonical-slots": "vitest run --config scripts/update-saas-product-smoke-fixture-canonical-slots.vitest.config.ts",
    "diagnostics:saas-isolation": "tsx scripts/report-saas-isolation-diagnostics.ts",
    "diagnostics:saas-isolation:test-scenarios": "tsx scripts/run-saas-isolation-test-scenarios.ts",
    "purge-placeholder-bookings": "tsx scripts/purge-placeholder-bookings.ts",
    "purge-placeholder-bookings:test": "vitest run --config scripts/purge-placeholder-bookings.vitest.config.ts",
    "realign-webapp-integrator-user": "tsx scripts/realign-webapp-integrator-user-projection.ts",
    "integrator-push-outbox-tick": "tsx scripts/integrator-push-outbox-tick.ts",
    "media-preview:tick": "tsx scripts/media-preview-process-tick.ts",
    "video-hls-backfill-legacy": "tsx scripts/video-hls-backfill-legacy.ts",
    "backfill-treatment-program-editor-draft-snapshots": "tsx scripts/backfill-treatment-program-editor-draft-snapshots.ts",
    "backfill-patient-specialist-links": "tsx scripts/backfill-patient-specialist-links.ts",
    "fio:download-russiannames": "node scripts/fio-backfill/download-russiannames-dataset.mjs",
    "fio:owner-reviewed-test:hash": "tsx scripts/fio-backfill/apply-owner-reviewed-fio-test.ts hash",
    "fio:owner-reviewed-test:seal": "tsx scripts/fio-backfill/apply-owner-reviewed-fio-test.ts seal",
    "fio:owner-reviewed-test:verify": "tsx scripts/fio-backfill/apply-owner-reviewed-fio-test.ts verify",
    "fio:owner-reviewed-test:preview": "tsx scripts/fio-backfill/apply-owner-reviewed-fio-test.ts preview",
    "fio:owner-reviewed-test:apply": "tsx scripts/fio-backfill/apply-owner-reviewed-fio-test.ts apply",
    "fio:owner-reviewed-test:rollback": "tsx scripts/fio-backfill/apply-owner-reviewed-fio-test.ts rollback",
    "fio:owner-reviewed-test:test": "vitest run --config scripts/fio-backfill/vitest.config.ts",
    "db:introspect": "drizzle-kit introspect && node scripts/fix-drizzle-introspect-defaults.mjs",
    "db:introspect:fix": "node scripts/fix-drizzle-introspect-defaults.mjs",
    "db:verify-public-table-count": "node scripts/verify-drizzle-public-table-count.mjs",
    "db:migrate:drizzle": "drizzle-kit migrate",
    "db:seed-drizzle-meta": "node scripts/seed-drizzle-migrations-meta.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1107.0",
    "@aws-sdk/s3-request-presigner": "3.1107.0",
    "@base-ui/react": "^1.7.0",
    "@bersoncare/db-principal": "workspace:*",
