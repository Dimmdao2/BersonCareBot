[
  {
    "id": "max.admin.start",
    "source": "max",
    "event": "message.received",
    "priority": 10,
    "match": {
      "input": {
        "text": "/start"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:admin.menu.hint",
          "delivery": {
            "channels": ["max"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "max.admin.debug.show_my_id",
    "source": "max",
    "event": "message.received",
    "priority": 100,
    "match": {
      "input": {
        "action": "debug.show_my_id"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "max:showMyId",
          "vars": {
            "channelId": "{{actor.channelUserId}}"
          },
          "delivery": {
            "channels": ["max"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "max.admin.stats.bookings",
    "source": "max",
    "event": "message.received",
    "priority": 10,
    "match": {
      "input": {
        "action": "admin.stats.bookings"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "conditions": [
      {
        "kind": "context.query",
        "name": "adminStats",
        "query": {
          "type": "admin.stats"
        }
      }
    ],
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:admin.stats.bookings",
          "vars": {
            "activeBookings": "{{queries.adminStats.activeBookings}}"
          },
          "delivery": {
            "channels": ["max"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "max.admin.stats.users",
    "source": "max",
    "event": "message.received",
    "priority": 10,
    "match": {
      "input": {
        "action": "admin.stats.users"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "conditions": [
      {
        "kind": "context.query",
        "name": "adminStats",
        "query": {
          "type": "admin.stats"
        }
      }
    ],
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:admin.stats.users",
          "vars": {
            "telegramTotal": "{{queries.adminStats.userCountsByIntegration.telegram.total}}",
            "telegramWithPhone": "{{queries.adminStats.userCountsByIntegration.telegram.withPhone}}"
          },
          "delivery": {
            "channels": ["max"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "max.admin.message.unmatched",
    "source": "max",
    "event": "message.received",
    "priority": 2,
    "match": {
      "actor": {
        "isAdmin": true
      },
      "input": {
        "relayContentPresent": true,
        "excludeActions": ["admin.stats.bookings", "admin.stats.users", "debug.show_my_id"]
      }
    },
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:admin.reply.hintUnmatched",
          "delivery": {
            "channels": ["max"],
            "maxAttempts": 1
          }
        }
      }
    ]
  }
]
