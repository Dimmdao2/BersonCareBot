[
  {
    "id": "max.contact.phone.link",
    "source": "max",
    "event": "message.received",
    "priority": 10,
    "match": {
      "context": {
        "conversationState": {
          "$notStartsWith": ["await_phoneauth:", "await_contact:"]
        }
      },
      "input": {
        "phonePresent": true
      }
    },
    "steps": [
      {
        "action": "user.phone.link",
        "mode": "sync",
        "params": {
          "channelUserId": "{{actor.channelUserId}}",
          "phoneNormalized": "{{input.phone}}"
        }
      },
      {
        "action": "message.inlineKeyboard.show",
        "mode": "async",
        "params": {
          "chatId": "{{actor.chatId}}",
          "templateKey": "max:welcome",
          "menu": "main",
          "delivery": {
            "channels": ["max"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "max.start.link",
    "source": "max",
    "event": "message.received",
    "priority": 55,
    "match": {
      "input": {
        "action": "start.link"
      }
    },
    "steps": [
      {
        "action": "webapp.channelLink.complete",
        "mode": "sync",
