    {
    "id": "max.bookings.show",
    "source": "max",
    "event": "callback.received",
    "match": {
      "input": {
        "action": "bookings.show"
      },
      "context": {
        "linkedPhone": true
      }
    },
    "conditions": [
      {
        "kind": "context.query",
        "name": "bookings",
        "query": {
          "type": "bookings.forUser",
          "userId": "{{context.phoneNormalized}}"
        }
      }
    ],
    "steps": [
      {
        "action": "message.edit",
        "mode": "async",
        "params": {
          "_when": {
            "path": "queries.bookings.items.length",
            "equals": 0
          },
          "chatId": "{{actor.chatId}}",
          "messageId": "{{input.messageId}}",
          "templateKey": "max:noBookings",
          "vars": {
            "queries": "{{queries}}"
          },
          "delivery": {
            "channels": ["max"],
            "maxAttempts": 1
          },
          "inlineKeyboard": [
            [
              {
                "textTemplateKey": "max:bookingsScreen.prepare",
                "callbackData": "info.prepare"
              }
            ],
            [
              {
                "textTemplateKey": "max:bookingsScreen.address",
                "callbackData": "info.address"
              }
            ],
            [
              {
                "text": "⬅️ Назад",
                "callbackData": "booking.menu"
              }
            ]
          ]
        }
      },
      {
        "action": "message.edit",
        "mode": "async",
        "params": {
          "_when": {
            "path": "queries.bookings.items.length",
            "truthy": true
          },
          "chatId": "{{actor.chatId}}",
          "messageId": "{{input.messageId}}",
          "templateKey": "max:bookingsList",
          "vars": {
            "queries": "{{queries}}"
          },
          "parseMode": "HTML",
          "delivery": {
            "channels": ["max"],
            "maxAttempts": 1
          },
          "inlineKeyboard": [
            [
              {
                "textTemplateKey": "max:bookingsScreen.prepare",
                "callbackData": "info.prepare"
              }
            ],
            [
              {
                "textTemplateKey": "max:bookingsScreen.address",
                "callbackData": "info.address"
              }
            ],
            [
