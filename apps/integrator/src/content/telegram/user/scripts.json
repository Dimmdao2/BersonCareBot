  {
    "id": "telegram.booking.open",
    "source": "telegram",
    "event": "message.received",
    "match": {
      "input": {
        "action": "booking.open"
      },
      "context": {
        "linkedPhone": true
      }
    },
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "_when": {
            "and": [
              {
                "path": "facts.links.webappCabinetUrl",
                "truthy": true
              },
              {
                "path": "facts.links.webappAddressUrl",
                "truthy": true
              }
            ]
          },
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "message": {},
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          },
          "templateKey": "telegram:bookingMessage",
          "inlineKeyboard": [
            [
              {
                "textTemplateKey": "telegram:bookingMenu.my",
                "callbackData": "bookings.show"
              }
            ],
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.prepare",
                "callbackData": "info.prepare"
              }
            ],
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.address",
                "callbackData": "info.address"
              }
            ]
          ]
        }
      },
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "_when": {
            "path": "facts.links.webappCabinetUrl",
            "truthy": false
          },
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "message": {},
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          },
          "templateKey": "telegram:bookingMessage",
          "inlineKeyboard": [
            [
              {
                "textTemplateKey": "telegram:bookingMenu.my",
                "callbackData": "bookings.show"
              }
            ],
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.prepare",
                "callbackData": "info.prepare"
              }
            ],
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.address",
                "callbackData": "info.address"
              }
            ]
          ]
        }
      }
    ]
  },
