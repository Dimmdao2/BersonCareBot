  {
    "id": "telegram.ask.question",
    "source": "telegram",
    "event": "message.received",
    "match": {
      "context": {
        "conversationState": "waiting_for_question"
      },
      "input": {
        "textPresent": true,
        "excludeActions": [
          "booking.open",
          "menu.more",
          "cabinet.open",
          "start.noticeme",
          "start.set",
          "phone.request.cancel",
          "start.phoneauth"
        ],
        "excludeTexts": [
          "/start",
          "⚙️ Меню",
          "Меню",
          "📅 Запись на приём",
          "Запись на приём",
          "👤 Кабинет",
          "Кабинет",
          "Отмена",
          "Вернуться в меню"
        ],
        "excludeTextPrefixes": [
          "/start"
        ]
      }
    },
    "steps": [
      {
        "action": "draft.upsertFromMessage",
        "mode": "sync",
        "params": {
          "source": "telegram"
        }
      },
      {
        "action": "message.inlineKeyboard.show",
        "mode": "async",
        "params": {
          "chatId": "{{actor.chatId}}",
          "templateKey": "telegram:confirmQuestion",
          "inlineKeyboard": [
            [
              {
                "text": "Да",
                "callbackData": "q_confirm:yes"
              },
              {
                "text": "Нет",
                "callbackData": "q_confirm:no"
              }
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "telegram.draft.replace",
    "source": "telegram",
    "event": "message.received",
    "match": {
      "context": {
        "hasActiveDraft": true,
        "conversationState": {
          "$notIn": [
            "waiting_for_question"
          ]
        }
      },
      "input": {
        "textPresent": true,
        "excludeActions": [
          "booking.open",
          "menu.more",
          "cabinet.open",
          "start.noticeme",
          "start.set",
          "phone.request.cancel",
          "start.phoneauth"
        ],
        "excludeTexts": [
          "/start",
          "⚙️ Меню",
          "Меню",
          "📅 Запись на приём",
          "Запись на приём",
          "👤 Кабинет",
          "Кабинет",
          "Отмена",
          "Вернуться в меню"
        ],
        "excludeTextPrefixes": [
          "/start"
        ]
      }
    },
    "steps": [
      {
        "action": "draft.replaceFromMessage",
        "mode": "sync",
        "params": {
          "source": "telegram"
        }
      },
      {
        "action": "message.inlineKeyboard.show",
        "mode": "async",
        "params": {
          "chatId": "{{actor.chatId}}",
          "templateKey": "telegram:confirmQuestion",
          "inlineKeyboard": [
            [
              {
                "text": "Да",
                "callbackData": "q_confirm:yes"
              },
              {
                "text": "Нет",
                "callbackData": "q_confirm:no"
              }
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "telegram.draft.send",
    "source": "telegram",
    "event": "callback.received",
    "match": {
      "context": {
        "hasActiveDraft": true
      },
      "input": {
        "action": "q_confirm:yes"
      }
    },
    "steps": [
      {
        "action": "draft.send",
        "mode": "sync",
        "params": {
          "source": "telegram",
          "adminTemplateKey": "telegram:adminForward"
        }
      },
      {
        "action": "user.state.set",
        "mode": "sync",
        "params": {
          "channelUserId": "{{actor.channelUserId}}",
          "state": "idle"
        }
      },
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "message": {},
          "delivery": {
            "channels": [
              "telegram"
            ],
            "maxAttempts": 1
          },
          "templateKey": "telegram:questionAccepted"
        }
      },
      {
        "action": "callback.answer",
        "mode": "async",
        "params": {
          "callbackQueryId": "{{input.callbackQueryId}}"
        }
      }
    ]
  },
  {
    "id": "telegram.q_confirm.no",
