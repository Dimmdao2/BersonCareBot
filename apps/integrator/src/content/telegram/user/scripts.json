              }
            ]
          ]
        }
      },
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "_when": {
            "path": "facts.links.remindersUrl",
            "truthy": false
          },
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "message": {},
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          },
          "templateKey": "telegram:notImplemented"
        }
      }
    ]
  },
