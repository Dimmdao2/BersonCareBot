            "chatId": "{{actor.chatId}}"
          },
          "message": {},
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          },
          "templateKey": "telegram:menu.webapp.prompt",
          "inlineKeyboard": [
            [
              {
                "textTemplateKey": "telegram:menu.webapp.openButton",
