  {
    "id": "telegram.cabinet.open.callback",
    "source": "telegram",
    "event": "callback.received",
    "match": {
      "input": {
        "action": "cabinet.open"
      },
      "context": {
        "linkedPhone": true
      }
    },
    "steps": [
      {
        "action": "message.replyKeyboard.show",
        "mode": "async",
        "params": {
          "chatId": "{{actor.chatId}}",
          "templateKey": "telegram:cabinet.placeholder",
