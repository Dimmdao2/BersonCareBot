  {
    "id": "telegram.bookings.show",
    "source": "telegram",
    "event": "callback.received",
    "match": {
      "input": {
        "action": "bookings.show"
      },
      "context": {
        "linkedPhone": true
      }
    },
    "conditions": [
      {
        "kind": "context.query",
        "name": "bookings",
        "query": {
          "type": "bookings.forUser",
          "userId": "{{context.phoneNormalized}}"
        }
      }
    ],
    "steps": [
      {
        "action": "message.edit",
        "mode": "async",
        "params": {
          "_when": {
            "path": "queries.bookings.items.length",
            "equals": 0
          },
          "chatId": "{{actor.chatId}}",
          "messageId": "{{input.messageId}}",
          "templateKey": "telegram:noBookings",
          "vars": {
            "queries": "{{queries}}"
          },
          "inlineKeyboard": [
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.prepare",
                "callbackData": "info.prepare"
              }
            ],
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.address",
                "callbackData": "info.address"
              }
            ],
            [
              {
                "text": "⬅️ Назад",
                "callbackData": "booking.menu"
              }
            ]
          ]
        }
      },
      {
        "action": "message.edit",
        "mode": "async",
        "params": {
          "_when": {
            "path": "queries.bookings.items.length",
            "truthy": true
          },
          "chatId": "{{actor.chatId}}",
          "messageId": "{{input.messageId}}",
          "templateKey": "telegram:bookingsList",
          "vars": {
            "queries": "{{queries}}"
          },
          "parseMode": "HTML",
          "inlineKeyboard": [
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.prepare",
                "callbackData": "info.prepare"
              }
            ],
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.address",
                "callbackData": "info.address"
              }
            ],
            [
              {
                "text": "⬅️ Назад",
                "callbackData": "booking.menu"
              }
            ]
          ]
        }
      },
      {
        "action": "callback.answer",
        "mode": "async",
        "params": {
          "callbackQueryId": "{{input.callbackQueryId}}"
        }
      }
    ]
  },
