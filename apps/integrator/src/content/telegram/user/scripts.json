  {
    "id": "telegram.booking.open",
    "source": "telegram",
    "event": "message.received",
    "match": {
      "input": {
        "action": "booking.open"
      },
      "context": {
        "linkedPhone": true
      }
    },
    "steps": [
      {
        "action": "user.state.set",
        "mode": "sync",
        "params": {
          "channelUserId": "{{actor.channelUserId}}",
          "state": "idle"
        }
      },
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "_when": {
            "and": [
              {
                "path": "facts.links.webappCabinetUrl",
                "truthy": true
              },
              {
                "path": "facts.links.webappAddressUrl",
                "truthy": true
              }
            ]
          },
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "message": {},
          "delivery": {
            "channels": [
              "telegram"
            ],
            "maxAttempts": 1
          },
          "templateKey": "telegram:bookingMessage",
          "inlineKeyboard": [
            [
              {
                "textTemplateKey": "telegram:bookingMenu.my",
                "webAppUrlFact": "links.webappCabinetUrl"
              }
            ],
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.prepare",
                "callbackData": "info.prepare"
              }
            ],
            [
              {
                "textTemplateKey": "telegram:bookingsScreen.address",
                "webAppUrlFact": "links.webappAddressUrl"
              }
            ]
          ]
        }
      },
