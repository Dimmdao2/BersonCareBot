[
  {
    "id": "telegram.start.link",
    "source": "telegram",
    "event": "message.received",
    "priority": 55,
    "match": {
      "input": {
        "action": "start.link"
      }
    },
    "steps": [
      {
        "action": "webapp.channelLink.complete",
        "mode": "sync",
        "params": {
          "linkToken": "{{input.linkSecret}}",
          "channelCode": "telegram",
          "externalId": "{{meta.userId}}"
        }
      }
    ]
  },
  {
    "id": "telegram.start.noticeme",
    "source": "telegram",
    "event": "message.received",
    "match": {
      "input": {
        "action": "start.noticeme"
      }
    },
    "steps": [
      {
        "action": "message.replyKeyboard.show",
        "mode": "async",
        "params": {
          "chatId": "{{actor.chatId}}",
          "templateKey": "telegram:confirmPhoneForBooking",
          "keyboard": [
            [
              {
                "textTemplateKey": "telegram:requestContact.button",
                "requestPhone": true
              }
            ]
          ],
          "resizeKeyboard": true,
          "oneTimeKeyboard": true
        }
      }
    ]
  },
  {
    "id": "telegram.start.onboarding",
    "source": "telegram",
    "event": "message.received",
    "priority": 15,
    "match": {
      "input": {
        "text": {
          "$startsWith": "/start"
        },
        "excludeActions": ["start.link", "start.noticeme", "start.phoneauth", "start.set"]
      },
      "context": {
        "linkedPhone": false
      }
    },
    "steps": [
      {
        "action": "message.replyKeyboard.show",
        "mode": "async",
        "params": {
          "chatId": "{{actor.chatId}}",
          "templateKey": "telegram:onboardingWelcome",
          "keyboard": [
            [
              {
                "textTemplateKey": "telegram:requestContact.button",
                "requestPhone": true
              }
            ]
          ],
          "resizeKeyboard": true,
          "oneTimeKeyboard": true
        }
      }
    ]
  },
