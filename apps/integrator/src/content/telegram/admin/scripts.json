[
  {
    "id": "telegram.admin.start",
    "source": "telegram",
    "event": "message.received",
    "priority": 10,
    "match": {
      "input": {
        "text": "/start"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:admin.menu.hint",
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "telegram.admin.debug.show_my_id",
    "source": "telegram",
    "event": "message.received",
    "priority": 100,
    "match": {
      "input": {
        "action": "debug.show_my_id"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:showMyId",
          "vars": {
            "channelId": "{{actor.channelUserId}}"
          },
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "telegram.admin.stats.bookings",
    "source": "telegram",
    "event": "message.received",
    "priority": 10,
    "match": {
      "input": {
        "action": "admin.stats.bookings"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "conditions": [
      {
        "kind": "context.query",
        "name": "adminStats",
        "query": {
          "type": "admin.stats"
        }
      }
    ],
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:admin.stats.bookings",
          "vars": {
            "activeBookings": "{{queries.adminStats.activeBookings}}"
          },
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "telegram.admin.stats.users",
    "source": "telegram",
    "event": "message.received",
    "priority": 10,
    "match": {
      "input": {
        "action": "admin.stats.users"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "conditions": [
      {
        "kind": "context.query",
        "name": "adminStats",
        "query": {
          "type": "admin.stats"
        }
      }
    ],
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:admin.stats.users",
          "vars": {
            "telegramTotal": "{{queries.adminStats.userCountsByIntegration.telegram.total}}",
            "telegramWithPhone": "{{queries.adminStats.userCountsByIntegration.telegram.withPhone}}"
          },
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          }
        }
      }
    ]
  },
  {
    "id": "telegram.admin.start.link",
    "source": "telegram",
    "event": "message.received",
    "priority": 20,
    "match": {
      "input": {
        "action": "start.link"
      },
      "actor": {
        "isAdmin": true
      }
    },
    "steps": [
      {
        "action": "webapp.channelLink.complete",
        "mode": "sync",
        "params": {
          "linkToken": "{{input.linkSecret}}",
          "channelCode": "telegram",
          "externalId": "{{meta.userId}}"
        }
      }
    ]
  },
  {
    "id": "telegram.admin.message.unmatched",
    "source": "telegram",
    "event": "message.received",
    "priority": 2,
    "match": {
      "actor": {
        "isAdmin": true
      },
      "input": {
        "relayContentPresent": true,
        "excludeActions": [
          "start.link",
          "admin.stats.bookings",
          "admin.stats.users",
          "debug.show_my_id"
        ],
        "excludeTexts": ["/start"]
      }
    },
    "steps": [
      {
        "action": "message.send",
        "mode": "async",
        "params": {
          "recipient": {
            "chatId": "{{actor.chatId}}"
          },
          "templateKey": "telegram:admin.reply.hintUnmatched",
          "delivery": {
            "channels": ["telegram"],
            "maxAttempts": 1
          }
        }
      }
    ]
  }
]
