{
  "name": "@bersoncare/integrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker:dev": "tsx watch src/infra/runtime/worker/main.ts",
    "scheduler:dev": "tsx watch src/infra/runtime/scheduler/main.ts",
    "clean": "rm -rf dist",
    "build": "pnpm --dir ../../packages/operator-db-schema run build && pnpm --dir ../../packages/db-principal run build && pnpm --dir ../../packages/platform-merge run build && pnpm --dir ../../packages/error-tracking run build && pnpm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker:start": "node dist/infra/runtime/worker/main.js",
    "scheduler:start": "node dist/infra/runtime/scheduler/main.js",
    "test": "vitest --run",
    "test:e2e": "RUN_E2E_TESTS=true vitest --run e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && node ../../scripts/check-queue-port-boundary.mjs && tsx src/infra/scripts/check-no-legacy-message-retry-producers.ts",
    "migrate": "tsx src/infra/db/migrate.ts",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:migrate:prod": "node dist/infra/db/migrate.js",
    "scenarios": "tsx e2e/run-webhook-scenarios.ts",
    "smsc:check": "tsx src/infra/scripts/check-smsc.ts",
    "s3:check": "tsx src/infra/scripts/check-s3.ts",
    "mail:check": "tsx src/infra/scripts/check-mail.ts",
    "reconcile:dev-patient-reminder-orphans": "tsx src/infra/scripts/reconcile-dev-patient-reminder-orphans.ts",
    "check:d30-no-legacy-message-retry-producers": "tsx src/infra/scripts/check-no-legacy-message-retry-producers.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bersoncare/db-principal": "workspace:*",
    "@bersoncare/error-tracking": "workspace:*",
    "@bersoncare/operator-db-schema": "workspace:*",
    "@bersoncare/platform-merge": "workspace:*",
    "@maxhub/max-bot-api": "^0.2.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "googleapis": "^171.4.0",
    "grammy": "^1.45.1",
    "luxon": "^3.7.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.5",
    "p-retry": "^7.1.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@types/luxon": "^3.7.4",
    "@types/node": "^25.5.2",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.21.0",
    "@types/web-push": "^3.6.4",
    "nock": "^14.0.17",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "undici": "^7.24.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
