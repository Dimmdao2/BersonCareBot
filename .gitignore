# Owner ruling 2026-07-26 (taskdb #1017): rewrites REAL people's password hashes to mint smoke-test
# session cookies (TEST is a production dump). TEST-only, guarded (see the DANGER header in the
# file itself) -- stays on this box, never in the repo. Do NOT "helpfully" re-add it; see
# docs/_TODO/SAAS_FOUNDATION/LOG.md for the pointer/rationale.
docs/_TODO/SAAS_FOUNDATION/scripts/regenerate-saas-smoke-fixture.mjs

# Снимок фактов живой TEST-базы для агентов-аудиторов (tools/db-facts-snapshot.sh).
# Не версионируется: снимается заново перед каждым аудитом.
.agent-facts.md

# Очереди конвейера — оперативное состояние лида, не история. В git их держать нельзя:
# слияние из клона откатывает файл к старой версии и уже выполненная строка запускается второй раз,
# а свежедобавленные строки исчезают (поймано 31.07 на очереди tariff).
runs/night-queue-*.txt
# Снимки процессорного времени для пульса — оперативное состояние, не история.
runs/pulse-cpu/

# Брифы прогонов — рабочие бумаги оркестрации, не документация проекта.
# Владелец 01.08: «ну ты ещё создай себе документы отдельно NO_CREATE_MANY_DOCS».
# Задание исполнителю живёт здесь и умирает вместе с прогоном; всё, что должно пережить прогон,
# переносится в план или канон. В docs/ брифов больше не заводим.
runs/briefs/
runs/orch-wakeup.md
# разовые прогоны мутаций: отчёт нужен тому, кто мерил, в истории репозитория ему делать нечего
runs/stryker-diffprobe/

# Локальный store pnpm, который агенты создают в клонах при установке зависимостей.
# Не игнорировался — из-за него клон становился «грязным» и конвейер отказывался запускать работу.
.pnpm-store-local/

